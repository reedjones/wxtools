{
  "name": "@wxtools/settings",
  "version": "0.1.0",
  "description": "Schema-driven settings with UI and API generation for WXT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "keywords": [
    "wxt",
    "browser-extension",
    "wxtools",
    "settings"
  ],
  "license": "MIT",
  "dependencies": {
    "@wxtools/core": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
